<h1 style="margin:0 0 16px;font-family:Unbounded,Inter,-apple-system,Helvetica,Arial,sans-serif;font-weight:800;font-size:22px;line-height:1.1;letter-spacing:-0.03em;text-transform:uppercase;color:#fff;">Your event needs changes</h1>
<p style="margin:0 0 14px;color:#fff;">Hi <%= @event.author_name %>,</p>
<p style="margin:0 0 14px;color:#fff;">We reviewed <strong><%= @event.title %></strong> and it needs a few changes before it can be approved:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;border-left:2px solid #ee2b2b;">
  <tr><td style="padding:4px 16px;color:#fff;white-space:pre-wrap;"><%= @event.rejection_reason %></td></tr>
</table>
<p style="margin:0 0 14px;color:#a3a3a3;">With those changes, submit your event again.</p>
<%= render "button", url: new_event_url(host: site_url, **url_locale), label: "Submit again" %>
