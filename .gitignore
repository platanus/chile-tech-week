# Production database dumps (bin/db-dump-production). They must never be committed.
/dumps/

# Env files — production .env lives on the server, not in git (see .env.sample).
/.env
/.env.*
!/.env.sample

# Logs.
/log/*
!/log/.keep

# Temp files, PIDs, bootsnap cache.
/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep
!/tmp/storage
/tmp/storage/*
!/tmp/storage/.keep

# Active Storage local files.
/storage/*
!/storage/.keep

# JS dependencies.
/node_modules/

# Vite build output (regenerated by `vite build` / `bin/dev`).
/public/vite/
/public/vite-dev/
/public/vite-test/
/public/vite-ssr/

# TypeScript incremental build info.
node_modules/.tmp/

# Local CodeGraph index.
/.codegraph/

# macOS.
.DS_Store

# Claude Code's local, machine-specific settings (permissions, etc.) — not shared config.
/.claude/settings.local.json

# Linked git worktrees (bin/start-worktree and Claude Code's own worktree support) —
# each is its own checkout, never content of this one.
/.claude/worktrees/

# Rails secrets — decrypts config/credentials.yml.enc.
/config/*.key
/config/credentials/*.key

# Typelizer output is regenerated.
/app/frontend/types/generated/

# Raw terrain tiles + Overpass/Overture responses (re-run npm run terrain:fetch to refill).
/scripts/terrain/.cache/
/scripts/brand/.cache/

# Bundler local config (written by `bundle config --local`).
/.bundle/

# Overmind socket (bin/dev).
/.overmind.sock
