# Production .env for the Rails app (lives on the server — NOT in git).
# In development everything is read from .env.local at the repo root instead.
# Every name here is a setting in app/configs/app_config.rb.

# Rails
SECRET_KEY_BASE=__generate_with_rails_secret__
POSTGRES_URL=postgres://user:pass@host:5432/tech_week_prod

# Misc
PRODUCTION_HOSTNAME=techweek.cl
# SITE_URL=https://techweek.cl
# ASSET_HOST=https://cdn.techweek.cl

# Luma — without a key the app talks to Luma::FakeClient (right for development, never
# for production). LUMA_ALLOWED_COHOST_DEV is development-only: the co-host addresses Luma
# may invite, so a local run never mails a real submitter.
LUMA_API_KEY=
LUMA_COVER_URL=https://techweek.cl/luma-cover.png
# LUMA_ALLOWED_COHOST_DEV=tu@correo.cl
# LUMA_CALENDAR_URL=https://lu.ma/cltw

# Mail — every message is logged under /admin/emails whatever this says. SEND_EMAILS=false
# (the default outside production) logs it and sends nothing; a real send outside production
# goes to EMAIL_CATCH_ALL instead of the recipient.
SEND_EMAILS=true
RESEND_API_KEY=
EMAIL_FROM=Chile Tech Week <hola@techweek.cl>
EMAIL_REPLY_TO=hola@techweek.cl
CONTACT_EMAIL=hola@techweek.cl
# EMAIL_CATCH_ALL=tu@correo.cl

# The team's heads-up on every new submission; empty = off.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
